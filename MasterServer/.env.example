# Copy to .env and fill in. Never commit .env.

# Shared secret game servers send as "Authorization: Bearer <token>".
# Generate one with:  openssl rand -hex 32
# Leave empty only for local development (heartbeats are then accepted without a token).
SERVER_TOKEN=

# Public DNS name of the master (docker-compose + Caddy only). Needs a DNS A record to the VPS.
MASTER_DOMAIN=master.example.com

# Optional (defaults shown)
# PORT=8080                    # HTTP port of the Node process
# HOST=                        # bind address; empty = all interfaces, 127.0.0.1 behind a local Caddy
# TRUST_PROXY=0                # 1 = use X-Forwarded-For (only behind a reverse proxy; compose sets it)
# TTL_SECONDS=30               # server disappears this long after its last heartbeat
# MAX_SERVERS=500
# RATE_HEARTBEAT_PER_MIN=60    # heartbeats + deletes per source IP per minute
# RATE_LIST_PER_MIN=30         # list requests per source IP per minute
