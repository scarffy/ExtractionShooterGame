/* ---------- Layers ---------- */

.hud-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 180px;
}

.inventory-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 10, 12, 0.78);
}

.hidden {
    display: none;
}

/* ---------- HUD ---------- */

.interaction-prompt {
    padding: 6px 14px;
    border-radius: 4px;
    background-color: rgba(10, 12, 14, 0.75);
    color: rgb(235, 235, 230);
    font-size: 20px;
    -unity-font-style: bold;
}

.equipment-hud {
    position: absolute;
    right: 32px;
    bottom: 28px;
    padding: 8px 14px;
    border-radius: 4px;
    background-color: rgba(10, 12, 14, 0.6);
    align-items: flex-end;
}

.equipment-hud__line {
    color: rgb(235, 235, 225);
    font-size: 18px;
    -unity-font-style: bold;
}

.equipment-hud__line--ammo {
    margin-bottom: 4px;
    font-size: 24px;
    -unity-text-align: middle-right;
}

.equipment-hud__line--dim {
    margin-top: 2px;
    color: rgba(235, 235, 225, 0.7);
    font-size: 15px;
    -unity-font-style: normal;
}

/* ---------- Raid HUD ---------- */

.raid-hud {
    position: absolute;
    top: 18px;
    padding: 6px 16px;
    border-radius: 4px;
    background-color: rgba(10, 12, 14, 0.6);
    color: rgb(235, 235, 225);
    font-size: 22px;
    -unity-font-style: bold;
}

.raid-hud--warning {
    color: rgb(240, 120, 90);
}

/* ---------- Extraction prompt (centre, below the crosshair) ---------- */

.extract-hud {
    position: absolute;
    left: 0;
    right: 0;
    top: 56%;
    align-items: center;
}

.extract-ring {
    width: 96px;
    height: 96px;
    margin-bottom: 8px;
    align-items: center;
    justify-content: center;
}

.extract-countdown {
    color: rgb(240, 245, 235);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.extract-title {
    padding: 4px 14px;
    border-radius: 4px;
    background-color: rgba(10, 12, 14, 0.7);
    color: rgb(120, 235, 140);
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.extract-detail {
    margin-top: 4px;
    padding: 2px 10px;
    border-radius: 3px;
    background-color: rgba(10, 12, 14, 0.55);
    color: rgb(225, 225, 215);
    font-size: 16px;
}

.extract-hud--blocked .extract-title {
    color: rgb(240, 225, 200);
}

.extract-hud--blocked .extract-detail,
.extract-hud--cancelled .extract-title {
    color: rgb(240, 120, 90);
}

/* ---------- Hideout ---------- */

.hideout-screen {
    background-color: rgb(16, 19, 22);
}

.sign-in-panel {
    width: 420px;
}

.sign-in-field {
    margin: 6px 0 4px 0;
}

.sign-in-error {
    min-height: 20px;
    margin-top: 8px;
    color: rgb(240, 120, 90);
    font-size: 14px;
}

.hideout-main {
    align-items: center;
}

.hideout-header {
    width: 1720px;
    margin-bottom: 12px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.hideout-title {
    color: rgb(240, 236, 220);
    font-size: 26px;
    -unity-font-style: bold;
}

.hideout-header__left,
.hideout-header__right {
    flex-direction: row;
    align-items: center;
}

.hideout-tab {
    height: 34px;
    margin: 0 0 0 16px;
    padding: 0 18px;
    border-radius: 4px;
    border-width: 0;
    background-color: rgb(40, 46, 52);
    color: rgba(230, 225, 210, 0.7);
    font-size: 16px;
    -unity-font-style: bold;
}

.hideout-tab:hover {
    background-color: rgb(56, 64, 72);
}

.hideout-tab--active {
    background-color: rgb(230, 190, 90);
    color: rgb(22, 26, 30);
}

.hideout-tab--active:hover {
    background-color: rgb(240, 204, 110);
}

.hideout-credits {
    margin: 0 18px;
    color: rgb(230, 190, 90);
    font-size: 22px;
    -unity-font-style: bold;
}

.trade-message {
    max-width: 520px;
    color: rgb(150, 200, 120);
    font-size: 14px;
    -unity-text-align: middle-right;
}

.trade-message--failed {
    color: rgb(240, 120, 90);
}

.deploy-button {
    width: 220px;
    height: 44px;
    margin: 0;
    font-size: 18px;
}

/* ---------- Columns & panels ---------- */

.inventory-columns {
    flex-direction: row;
    align-items: flex-start;
}

.inventory-column {
    width: 540px;
    margin: 0 10px;
}

/* Equipment holds 7 slots: 4 per row. */
.inventory-column--gear {
    width: 384px;
}

/* Trader: takes the place of the loadout and bag columns (384 + 540 + their margins). */
.inventory-column--trader {
    width: 944px;
}

/* Squad tab: same place and width as the trader column. */
.inventory-column--squad {
    width: 944px;
}

/* ---------- Squad & matchmaking ---------- */

.queue-status {
    max-width: 320px;
    margin-right: 16px;
    color: rgb(150, 200, 120);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    white-space: normal;
}

.hideout-tab--alert {
    border-width: 2px;
    border-color: rgb(150, 200, 120);
}

.deploy-button--cancel {
    background-color: rgb(120, 60, 50);
}

.deploy-button--cancel:hover {
    background-color: rgb(140, 72, 60);
}

.squad-code {
    margin-bottom: 8px;
    color: rgb(230, 190, 90);
    font-size: 20px;
    -unity-font-style: bold;
}

.squad-empty {
    white-space: normal;
}

.squad-members {
    margin-bottom: 4px;
}

.squad-member {
    flex-direction: row;
    align-items: center;
    height: 40px;
    margin-bottom: 6px;
    padding: 0 12px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    background-color: rgb(30, 35, 40);
}

.squad-member--self {
    border-color: rgba(230, 190, 90, 0.45);
}

.squad-member__name {
    flex-grow: 1;
    color: rgb(235, 235, 225);
    font-size: 17px;
    -unity-font-style: bold;
}

.squad-member__tag {
    margin-left: 12px;
    color: rgba(230, 225, 210, 0.55);
    font-size: 14px;
}

.squad-member__tag--leader {
    color: rgb(230, 190, 90);
}

.squad-member__tag--ready {
    color: rgb(150, 200, 120);
    -unity-font-style: bold;
}

.squad-row {
    flex-direction: row;
    align-items: center;
}

.squad-button {
    min-width: 120px;
    margin: 10px 10px 0 0;
    padding: 0 16px;
}

.squad-button--neutral {
    background-color: rgb(70, 70, 76);
}

.squad-button--neutral:hover {
    background-color: rgb(86, 86, 94);
}

.squad-button--active {
    background-color: rgb(150, 200, 120);
    color: rgb(22, 26, 30);
}

.squad-field {
    width: 260px;
    height: 34px;
    margin: 10px 10px 0 0;
    font-size: 15px;
}

.squad-invite {
    flex-direction: row;
    align-items: center;
    border-color: rgba(150, 200, 120, 0.6);
}

.squad-invite__label {
    flex-grow: 1;
    color: rgb(235, 235, 225);
    font-size: 17px;
    -unity-font-style: bold;
}

.squad-queue {
    min-height: 24px;
    color: rgb(150, 200, 120);
    font-size: 18px;
    -unity-font-style: bold;
}

.squad-message {
    min-height: 20px;
    margin-top: 6px;
    color: rgb(230, 225, 210);
    font-size: 14px;
    white-space: normal;
}

.squad-note {
    margin-top: 8px;
    color: rgba(230, 225, 210, 0.5);
    font-size: 13px;
    white-space: normal;
}

.trader-filters {
    flex-direction: row;
    margin-bottom: 8px;
}

.trader-filter {
    height: 26px;
    margin: 0 0 0 6px;
    padding: 0 12px;
    border-radius: 4px;
    border-width: 0;
    background-color: rgb(40, 46, 52);
    color: rgba(230, 225, 210, 0.75);
    font-size: 13px;
}

.trader-filter:hover {
    background-color: rgb(56, 64, 72);
}

.trader-filter--active {
    background-color: rgb(70, 86, 52);
    color: rgb(240, 240, 235);
}

/* Stash: 10 slots per row. Declared after .inventory-column so it wins. */
.inventory-column--stash {
    width: 888px;
}

.inventory-panel {
    margin-bottom: 14px;
    padding: 12px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(22, 26, 30, 0.95);
}

.panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.panel-title {
    margin-bottom: 8px;
    color: rgb(230, 225, 210);
    font-size: 20px;
    -unity-font-style: bold;
}

.panel-empty {
    padding: 10px 0 6px 0;
    color: rgba(230, 225, 210, 0.45);
    font-size: 14px;
}

.panel-button {
    height: 34px;
    margin: 10px 0 0 0;
    border-radius: 4px;
    border-width: 0;
    background-color: rgb(70, 86, 52);
    color: rgb(240, 240, 235);
    font-size: 15px;
    -unity-font-style: bold;
}

.panel-button:hover {
    background-color: rgb(88, 108, 64);
}

.panel-button:active {
    background-color: rgb(58, 72, 44);
}

.panel-button--small {
    height: 26px;
    margin: 0 0 8px 0;
    padding: 0 12px;
    background-color: rgb(70, 70, 76);
    font-size: 13px;
}

/* ---------- Slots ---------- */

.slot-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.slot {
    width: 78px;
    height: 78px;
    margin: 3px;
    padding: 4px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
    border-left-width: 3px;
    border-left-color: rgba(255, 255, 255, 0.25);
    background-color: rgba(40, 46, 52, 0.95);
    justify-content: space-between;
}

.slot:hover {
    background-color: rgba(62, 70, 78, 0.95);
    border-color: rgba(255, 255, 255, 0.35);
}

.slot--empty {
    border-left-color: rgba(255, 255, 255, 0.06);
    background-color: rgba(30, 34, 38, 0.8);
}

.slot--empty:hover {
    background-color: rgba(30, 34, 38, 0.8);
    border-color: rgba(255, 255, 255, 0.10);
}

.slot--active {
    border-color: rgb(230, 190, 90);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
}

.slot--dragging {
    opacity: 0.35;
}

.slot--broken {
    background-color: rgba(70, 30, 30, 0.95);
}

.slot__icon {
    position: absolute;
    left: 16px;
    right: 16px;
    top: 12px;
    bottom: 22px;
    -unity-background-scale-mode: scale-to-fit;
}

.slot__caption {
    display: none;
    color: rgba(230, 230, 225, 0.35);
    font-size: 10px;
    white-space: normal;
    -unity-text-align: middle-center;
    flex-grow: 1;
}

.slot--empty .slot__caption {
    display: flex;
}

.slot__name {
    color: rgb(230, 230, 225);
    font-size: 11px;
    white-space: normal;
    -unity-font-style: bold;
    overflow: hidden;
    max-height: 30px;
}

.slot__footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
}

.slot__detail {
    color: rgba(200, 200, 190, 0.85);
    font-size: 11px;
}

.slot__quantity {
    color: rgb(210, 210, 200);
    font-size: 13px;
    -unity-font-style: bold;
}

/* ---------- Grid inventories ----------
   Geometry comes from GridMetrics (UI/Inventory/GridMetrics.cs): 64px pitch, 4px gap, so cells are 60px.
   Cells, item tiles and the drop preview are positioned inline; these rules only style them. */

.slot-grid--cells {
    position: relative;
    flex-direction: row;
    flex-wrap: nowrap;
    flex-shrink: 0;
    margin: 2px 0 2px 0;
}

.grid-cell {
    position: absolute;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    background-color: rgba(30, 34, 38, 0.8);
}

.slot.grid-item {
    position: absolute;
    margin: 0;
    padding: 4px 5px;
}

.slot.grid-item .slot__name {
    max-height: none;
}

.grid-placement {
    position: absolute;
    border-radius: 4px;
    border-width: 2px;
}

.grid-placement--valid {
    border-color: rgb(120, 200, 110);
    background-color: rgba(120, 200, 110, 0.18);
}

.grid-placement--invalid {
    border-color: rgb(230, 100, 80);
    background-color: rgba(230, 100, 80, 0.18);
}

/* Category colour stripe */
.slot--ammo     { border-left-color: rgb(196, 160, 72); }
.slot--medical  { border-left-color: rgb(196, 72, 72); }
.slot--valuable { border-left-color: rgb(120, 170, 220); }
.slot--weapon   { border-left-color: rgb(170, 170, 170); }
.slot--armor    { border-left-color: rgb(110, 150, 100); }
.slot--misc     { border-left-color: rgb(150, 140, 120); }

/* Trader offers: price in the footer, dimmed when unaffordable. */
.slot--offer .slot__detail {
    color: rgb(230, 190, 90);
    -unity-font-style: bold;
}

.slot--unaffordable {
    opacity: 0.4;
}

/* ---------- Drag ghost ---------- */

.drag-ghost {
    position: absolute;
    padding: 4px 10px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(230, 190, 90);
    background-color: rgba(22, 26, 30, 0.95);
    color: rgb(240, 236, 220);
    font-size: 14px;
    -unity-font-style: bold;
}

/* ---------- Footer ---------- */

.item-details {
    min-height: 26px;
    margin-top: 6px;
    color: rgb(225, 220, 205);
    font-size: 16px;
}

.inventory-hint {
    margin-top: 4px;
    color: rgba(225, 220, 205, 0.55);
    font-size: 14px;
}

/* A move that failed (no room, bag not empty): shown for a few seconds. */
.inventory-notice {
    min-height: 22px;
    margin-top: 2px;
    color: rgb(235, 120, 95);
    font-size: 15px;
    -unity-font-style: bold;
}

/* ---------- Character preview, gear value, safe box ---------- */

.preview-panel {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
}

.character-preview {
    width: 120px;
    height: 150px;
    border-radius: 4px;
    background-color: rgba(10, 12, 14, 0.9);
    -unity-background-scale-mode: scale-and-crop;
}

.gear-value {
    flex-grow: 1;
    margin-left: 16px;
    color: rgb(230, 190, 90);
    font-size: 16px;
    white-space: normal;
}

.inventory-panel--safe {
    border-color: rgba(230, 190, 90, 0.45);
}

/* Stash scrolls inside a fixed height, leaving room under it for an opened bag. */
.stash-scroll {
    height: 780px;
}

.stash-scroll--compact {
    height: 420px;
}

/* ======================================================================================
   Delta Force-style loadout layout (hideout stash and raid inventory):
   character | equipment slots | chest rig · pockets · backpack · safe box | stash or loot
   ====================================================================================== */

.hideout-header {
    width: 1870px;
}

.inventory-column {
    margin: 0 10px;
}

/* Character render with name and gear value at the bottom. */
.character-column {
    width: 310px;
    height: 800px;
    justify-content: space-between;
}

.character-column .character-preview {
    width: 310px;
    height: 720px;
    border-radius: 6px;
    background-color: rgba(22, 26, 30, 0.6);
    -unity-background-scale-mode: scale-to-fit;
}

.character-footer {
    padding: 6px 4px 0 4px;
}

.character-name {
    color: rgb(225, 220, 205);
    font-size: 30px;
    -unity-font-style: bold;
}

.character-footer .gear-value {
    margin-left: 0;
    color: rgb(230, 190, 90);
    font-size: 16px;
}

/* Equipment: helmet, armor, pistol, melee stacked; primaries wide underneath. */
.equipment-column {
    width: 260px;
}

.equipment-grid {
    flex-direction: column;
    align-items: flex-end;
}

.equip-host {
    margin-bottom: 8px;
}

.equip-host--square {
    width: 130px;
    height: 112px;
}

.equip-host--wide {
    width: 260px;
    height: 112px;
}

.equip-host--item {
    width: 110px;
    height: 120px;
    margin: 0 10px 0 0;
}

.equip-host > .slot {
    width: 100%;
    height: 100%;
    margin: 0;
}

/* Middle: storage sections, scrolling when tall. */
.storage-column {
    width: 540px;
    height: 800px;
}

.storage-section {
    margin-bottom: 10px;
    padding: 0 10px 10px 10px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(22, 26, 30, 0.95);
}

.storage-section--safe {
    border-color: rgba(230, 190, 90, 0.45);
}

.storage-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.storage-title {
    margin: 0 -10px 10px -10px;
    padding: 6px 10px;
    background-color: rgba(255, 255, 255, 0.05);
    color: rgb(230, 225, 210);
    font-size: 17px;
    -unity-font-style: bold;
}

.storage-header .storage-title {
    flex-grow: 1;
}

.storage-header .panel-button {
    margin: 0 0 10px 8px;
}

.storage-row {
    flex-direction: row;
    align-items: flex-start;
}

.storage-body {
    flex-grow: 1;
}

.safebox-icon {
    width: 120px;
    height: 120px;
    margin-right: 10px;
    padding: 8px;
    border-radius: 4px;
    background-color: rgba(40, 46, 52, 0.95);
    justify-content: space-between;
}

.safebox-icon__name {
    color: rgb(230, 190, 90);
    font-size: 14px;
    -unity-font-style: bold;
    white-space: normal;
}

.safebox-icon__note {
    color: rgba(230, 225, 210, 0.55);
    font-size: 12px;
}

/* Right: stash (hideout) or loot (raid). 10 cells across plus scrollbar. */
.inventory-column--stash,
.loot-column {
    width: 680px;
}

.stash-scroll {
    height: 720px;
}

.stash-scroll--compact {
    height: 380px;
}

/* Trader and squad take the place of the character, equipment and storage columns. */
.inventory-column--trader,
.inventory-column--squad {
    width: 1150px;
}

.storage-header {
    margin: 0 -10px 10px -10px;
    padding: 4px 10px;
    background-color: rgba(255, 255, 255, 0.05);
}

.storage-header .storage-title {
    margin: 0;
    padding: 2px 0;
    background-color: rgba(0, 0, 0, 0);
}

.storage-header .panel-button {
    height: 26px;
    margin: 0 0 0 8px;
    font-size: 13px;
}

.character-weight {
    color: rgb(225, 220, 205);
    font-size: 18px;
    -unity-font-style: bold;
}

.character-weight--heavy {
    color: rgb(240, 200, 90);
}

.character-weight--overloaded {
    color: rgb(240, 110, 90);
}

/* ---------- End-of-raid summary (over the hideout) ---------- */

.raid-summary {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 8, 10, 0.82);
}

.raid-summary__panel {
    width: 560px;
    padding: 28px 32px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(230, 190, 90, 0.5);
    background-color: rgb(22, 26, 30);
}

.raid-summary__caption {
    color: rgba(230, 225, 210, 0.55);
    font-size: 14px;
    -unity-font-style: bold;
}

.raid-summary__result {
    margin-top: 6px;
    color: rgb(240, 236, 220);
    font-size: 36px;
    -unity-font-style: bold;
}

.raid-summary__result--success {
    color: rgb(140, 210, 110);
}

.raid-summary__result--failed {
    color: rgb(240, 110, 90);
}

.raid-summary__time {
    margin-bottom: 18px;
    color: rgba(230, 225, 210, 0.7);
    font-size: 16px;
}

.raid-summary__row {
    flex-direction: row;
    justify-content: space-between;
    padding: 6px 0;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.raid-summary__row--total {
    border-bottom-width: 0;
    margin-top: 6px;
}

.raid-summary__label {
    color: rgba(230, 225, 210, 0.8);
    font-size: 17px;
}

.raid-summary__value {
    color: rgb(240, 236, 220);
    font-size: 17px;
    -unity-font-style: bold;
}

.raid-summary__value--gain {
    color: rgb(140, 210, 110);
}

.raid-summary__value--loss {
    color: rgb(240, 110, 90);
}

.raid-summary__note {
    margin-top: 14px;
    color: rgba(230, 225, 210, 0.5);
    font-size: 13px;
}

.raid-summary .deploy-button {
    align-self: flex-end;
    margin-top: 18px;
}

/* ---------- Raid difficulty picker (hideout header) ---------- */

.difficulty-picker {
    flex-direction: row;
    margin-right: 14px;
    padding: 3px;
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.05);
}

.difficulty-button {
    width: 92px;
    height: 38px;
    margin: 0 2px;
    border-width: 0;
    border-radius: 4px;
    font-size: 15px;
    -unity-font-style: bold;
    color: rgba(230, 225, 210, 0.6);
    background-color: rgba(0, 0, 0, 0);
}

.difficulty-button:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.difficulty-button--active {
    color: rgb(22, 26, 30);
    background-color: rgb(230, 190, 90);
}

.difficulty-button--active.difficulty-button--easy {
    background-color: rgb(140, 200, 120);
}

.difficulty-button--active.difficulty-button--hard {
    background-color: rgb(230, 110, 90);
}

.difficulty-picker:disabled {
    opacity: 0.6;
}

/* ---------- Rarity (loot agent) ----------
   Delta Force colours by value: white, green, blue, purple, gold, red (RarityStyle.cs / Core RarityRules).
   A tinted tile background plus a coloured bar along the bottom; the category stripe stays on the left. */
.slot.rarity--white  { background-color: rgba(50, 55, 61, 0.95);  border-bottom-width: 3px; border-bottom-color: rgb(150, 155, 160); }
.slot.rarity--green  { background-color: rgba(51, 74, 61, 0.95);  border-bottom-width: 3px; border-bottom-color: rgb(95, 184, 95); }
.slot.rarity--blue   { background-color: rgba(48, 65, 86, 0.95);  border-bottom-width: 3px; border-bottom-color: rgb(79, 143, 224); }
.slot.rarity--purple { background-color: rgba(66, 58, 86, 0.95);  border-bottom-width: 3px; border-bottom-color: rgb(168, 106, 224); }
.slot.rarity--gold   { background-color: rgba(77, 72, 54, 0.95);  border-bottom-width: 3px; border-bottom-color: rgb(224, 176, 64); }
.slot.rarity--red    { background-color: rgba(77, 53, 56, 0.95);  border-bottom-width: 3px; border-bottom-color: rgb(224, 80, 74); }

.slot.rarity--white:hover  { background-color: rgba(64, 70, 76, 0.95); }
.slot.rarity--green:hover  { background-color: rgba(58, 90, 66, 0.95); }
.slot.rarity--blue:hover   { background-color: rgba(52, 77, 107, 0.95); }
.slot.rarity--purple:hover { background-color: rgba(81, 65, 107, 0.95); }
.slot.rarity--gold:hover   { background-color: rgba(99, 88, 56, 0.95); }
.slot.rarity--red:hover    { background-color: rgba(99, 57, 59, 0.95); }

/* Keys: category stripe. */
.slot--key { border-left-color: rgb(205, 190, 120); }

/* Broken armor stays red-brown whatever its rarity; the bar still shows the tier. */
.slot.slot--broken { background-color: rgba(70, 30, 30, 0.95); }
.slot.slot--broken:hover { background-color: rgba(86, 38, 38, 0.95); }

/* ---------- Hideout: stash upgrade, workbench (crafting + gun bench) ---------- */

/* Pushed right, next to Sort. */
.stash-upgrade-button {
    margin-left: auto;
    margin-right: 8px;
    background-color: rgb(120, 98, 44);
}

.stash-upgrade-button:hover {
    background-color: rgb(146, 120, 54);
}

/* Same place and width as the trader and squad columns. */
.inventory-column--workbench {
    width: 1150px;
}

.workbench-body {
    flex-direction: row;
    align-items: flex-start;
}

.workbench-main {
    width: 640px;
    height: 700px;
    margin-right: 14px;
}

.workbench-side {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 10px 12px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.04);
}

.workbench-subtitle {
    margin-bottom: 8px;
    color: rgb(230, 190, 90);
    font-size: 16px;
    -unity-font-style: bold;
}

/* Recipe rows: left accent by output category, like stash slots. */
.workbench-recipe {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
    padding: 8px 10px;
    border-radius: 4px;
    border-width: 1px;
    border-left-width: 4px;
    border-color: rgba(255, 255, 255, 0.08);
    background-color: rgb(30, 35, 40);
}

.workbench-recipe:hover {
    background-color: rgb(38, 44, 50);
}

.workbench-recipe--ready {
    border-right-color: rgba(150, 200, 120, 0.45);
    border-top-color: rgba(150, 200, 120, 0.45);
    border-bottom-color: rgba(150, 200, 120, 0.45);
}

.workbench-recipe.slot--ammo     { border-left-color: rgb(196, 160, 72); }
.workbench-recipe.slot--medical  { border-left-color: rgb(196, 72, 72); }
.workbench-recipe.slot--valuable { border-left-color: rgb(120, 170, 220); }
.workbench-recipe.slot--weapon   { border-left-color: rgb(170, 170, 170); }
.workbench-recipe.slot--armor    { border-left-color: rgb(110, 150, 100); }
.workbench-recipe.slot--attachment { border-left-color: rgb(150, 120, 200); }

.workbench-recipe__info {
    flex-grow: 1;
    flex-shrink: 1;
}

.workbench-recipe__name {
    color: rgb(235, 235, 225);
    font-size: 16px;
    -unity-font-style: bold;
}

.workbench-recipe__meta {
    margin-top: 4px;
    color: rgba(230, 225, 210, 0.55);
    font-size: 13px;
}

.workbench-recipe__button {
    width: 96px;
    margin: 0 0 0 10px;
}

.workbench-chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
}

.workbench-chip {
    margin: 2px 6px 2px 0;
    padding: 2px 8px;
    border-radius: 3px;
    background-color: rgba(150, 200, 120, 0.14);
    color: rgb(170, 215, 140);
    font-size: 13px;
}

.workbench-chip--missing {
    background-color: rgba(240, 120, 90, 0.14);
    color: rgb(240, 130, 100);
}

/* Craft queue. */
.workbench-job {
    margin-bottom: 8px;
    padding: 8px 10px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    background-color: rgb(30, 35, 40);
}

.workbench-job--done {
    border-color: rgba(150, 200, 120, 0.6);
}

.workbench-job--empty {
    color: rgba(230, 225, 210, 0.35);
    font-size: 14px;
    -unity-text-align: middle-center;
    border-color: rgba(255, 255, 255, 0.05);
    background-color: rgba(0, 0, 0, 0);
}

.workbench-job__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.workbench-job__name {
    color: rgb(235, 235, 225);
    font-size: 15px;
    -unity-font-style: bold;
}

.workbench-job__time {
    color: rgb(230, 190, 90);
    font-size: 15px;
    -unity-font-style: bold;
}

.workbench-job--done .workbench-job__time {
    color: rgb(150, 200, 120);
}

.workbench-progress {
    height: 6px;
    margin-top: 6px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.08);
    overflow: hidden;
}

.workbench-progress__fill {
    height: 100%;
    width: 0;
    background-color: rgb(230, 190, 90);
}

.workbench-job--done .workbench-progress__fill {
    background-color: rgb(150, 200, 120);
}

.workbench-job__button {
    height: 28px;
    margin-top: 8px;
}

/* Gun bench. */
.gunbench-picker {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 10px;
}

.gunbench-picker .trader-filter {
    margin: 2px 6px 2px 0;
}

.gunbench-note {
    margin: 4px 10px 4px 0;
    color: rgba(230, 225, 210, 0.5);
    font-size: 13px;
    white-space: normal;
}

.gunbench-title {
    margin: 6px 0 8px 0;
    color: rgb(240, 236, 220);
    font-size: 20px;
    -unity-font-style: bold;
}

.gunbench-stats {
    margin-bottom: 10px;
    padding: 6px 10px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.04);
}

.gunbench-stat {
    flex-direction: row;
    height: 22px;
    align-items: center;
}

.gunbench-stat__name {
    width: 160px;
    color: rgba(230, 225, 210, 0.6);
    font-size: 14px;
}

.gunbench-stat__bare {
    width: 140px;
    color: rgba(230, 225, 210, 0.45);
    font-size: 14px;
}

.gunbench-stat__now {
    color: rgb(235, 235, 225);
    font-size: 14px;
    -unity-font-style: bold;
}

.gunbench-stat--better {
    color: rgb(150, 210, 120);
}

.gunbench-stat--worse {
    color: rgb(240, 130, 100);
}

.gunbench-slot {
    margin-bottom: 6px;
    padding: 6px 10px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    background-color: rgb(30, 35, 40);
}

.gunbench-slot__header {
    flex-direction: row;
    align-items: center;
    min-height: 28px;
}

.gunbench-slot__name {
    width: 110px;
    color: rgba(230, 225, 210, 0.6);
    font-size: 14px;
}

.gunbench-slot__fitted {
    flex-grow: 1;
    color: rgb(235, 235, 225);
    font-size: 15px;
    -unity-font-style: bold;
}

.gunbench-slot__fitted--empty {
    color: rgba(230, 225, 210, 0.35);
    -unity-font-style: normal;
}

.gunbench-slot__remove {
    margin: 0;
}

.gunbench-fit {
    margin: 2px 6px 2px 0;
}

.gunbench-name-field {
    flex-grow: 1;
    width: auto;
}

.gunbench-save-button {
    min-width: 110px;
    margin-right: 0;
}

.workbench-presets {
    height: 600px;
    margin-top: 10px;
}

.gunbench-preset {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
    padding: 8px 10px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    background-color: rgb(30, 35, 40);
}

.gunbench-preset__info {
    flex-grow: 1;
    flex-shrink: 1;
}

.gunbench-preset__name {
    color: rgb(235, 235, 225);
    font-size: 15px;
    -unity-font-style: bold;
}

.gunbench-preset__name:hover {
    color: rgb(230, 190, 90);
}

.gunbench-preset__parts {
    margin-top: 2px;
    color: rgba(230, 225, 210, 0.55);
    font-size: 12px;
    white-space: normal;
}

.gunbench-preset__buy {
    min-width: 120px;
    height: 30px;
    margin: 0 0 0 8px;
}

.gunbench-preset__delete {
    height: 30px;
    margin: 0 0 0 6px;
    padding: 0 10px;
}
